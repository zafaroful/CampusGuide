<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusGuide.Views.Map.FloorPlanPage"
             Title="Floor Plan"
             BackgroundColor="White">

    <VerticalStackLayout Padding="0" Spacing="0">

        <!-- Header -->
        <VerticalStackLayout Padding="15" BackgroundColor="#512BD4" Spacing="10">
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Button x:Name="BackButton" Text="← Back" 
                        SemanticProperties.Hint="Returns to the previous page"
                        BackgroundColor="White" TextColor="Black"
                        Padding="10" FontSize="12" CornerRadius="5"
                        HorizontalOptions="Start"/>
                <Label Text="Floor Plans" FontSize="20" FontAttributes="Bold" 
                       TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Building and Floor Info -->
            <VerticalStackLayout Spacing="5">
                <Label x:Name="BuildingNameLabel" Text="Building: Academic Block A"
                       FontSize="14" FontAttributes="Bold" TextColor="White"/>
                <Label x:Name="FloorCountLabel" Text="Floors: 3"
                       FontSize="12" TextColor="White"/>
            </VerticalStackLayout>

            <!-- Floor Selector -->
            <Label Text="Select Floor:" FontSize="12" FontAttributes="Bold" 
                   TextColor="White" Margin="0,5,0,0"/>
            <HorizontalStackLayout x:Name="FloorSelectorLayout" Spacing="8" 
                                   HorizontalOptions="Fill">
                <!-- Floor buttons will be added programmatically -->
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Floor Plan Container -->
        <Grid RowDefinitions="*" ColumnDefinitions="*" 
              Padding="0" RowSpacing="0" ColumnSpacing="0"
              VerticalOptions="Fill" HorizontalOptions="Fill">

            <!-- Scrollable Floor Plan Image -->
            <ScrollView Grid.Row="0" Grid.Column="0"
                       Padding="0" VerticalScrollBarVisibility="Never"
                       HorizontalScrollBarVisibility="Never">
                <Grid RowDefinitions="*" ColumnDefinitions="*">
                    <Image x:Name="FloorPlanImage" 
                           SemanticProperties.Description="Floor plan for the selected floor"
                           Aspect="AspectFit"
                           Grid.Row="0" Grid.Column="0"
                           Margin="10"/>

                    <!-- Overlay Canvas for Location Pins -->
                    <GraphicsView x:Name="PinOverlay"
                                 Grid.Row="0" Grid.Column="0"
                                 Margin="10"/>
                </Grid>
            </ScrollView>

            <!-- Loading Indicator -->
            <VerticalStackLayout Grid.Row="0" Grid.Column="0"
                                x:Name="LoadingContainer"
                                Padding="20" Spacing="10"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">
                <Label Text="Loading floor plan..." 
                       FontSize="16" HorizontalOptions="Center"/>
                <ActivityIndicator IsRunning="True" Color="#512BD4"
                                  SemanticProperties.Description="Loading floor plan"
                                  HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Unavailable Floor Plan Message -->
            <VerticalStackLayout Grid.Row="0" Grid.Column="0"
                                x:Name="UnavailableContainer"
                                Padding="20" Spacing="15"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">
                <Label Text="⚠️ Floor Plan Unavailable"
                       FontSize="18" FontAttributes="Bold"
                       HorizontalOptions="Center" TextColor="#FF6B6B"/>
                <Label Text="The floor plan image for this floor is not available yet."
                       FontSize="14" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       FontSize="14" TextColor="#FF6B6B"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="LocationListLabel" Text="Locations on this floor:"
                       FontSize="12" FontAttributes="Bold"
                       HorizontalOptions="Center" Margin="0,20,0,0"/>
                <CollectionView x:Name="LocationsCollectionView"
                               SelectionMode="Single"
                               SemanticProperties.Description="List of locations on this floor"
                               Margin="0,10,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" CornerRadius="8" HasShadow="True">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"/>
                                    <Label Text="{Binding Type}" FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>

        <!-- Floor Info Footer -->
        <VerticalStackLayout Padding="15" BackgroundColor="#F5F5F5" Spacing="5">
            <Label x:Name="FloorInfoLabel" Text="Ground Floor - 2 locations"
                   FontSize="12" TextColor="#333333"/>
            <Label x:Name="LocationCountLabel" Text="Locations: 2"
                   FontSize="11" TextColor="#666666"/>
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>
