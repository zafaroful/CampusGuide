<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusGuide.Views.AboutPage"
             Title="About"
             BackgroundColor="{AppThemeBinding Light=#F5F7F8, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Padding="0,10">
                <Label Text="CampusGuide"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                       HorizontalTextAlignment="Center"
                       SemanticProperties.HeadingLevel="Level1"/>
                <Label Text="v1.0.0" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center"/>
                <Label Text="Built with .NET 10 MAUI" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1F22}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3A3D42}"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="About This App"
                           Style="{StaticResource SectionTitleLabel}"
                           SemanticProperties.HeadingLevel="Level2"/>
                    <Label Text="CampusGuide is a comprehensive mobile application designed to help students, faculty, and visitors navigate the campus efficiently. With interactive maps, location search, QR code scanning, and indoor floor planning, CampusGuide transforms campus exploration into an intuitive, user-friendly experience."
                           Style="{StaticResource BodyLabel}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1F22}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3A3D42}"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Key Features"
                           Style="{StaticResource SectionTitleLabel}"
                           SemanticProperties.HeadingLevel="Level2"/>
                    <Label Text="• Interactive Campus Map with clustering" Style="{StaticResource BodyLabel}"/>
                    <Label Text="• Location Search with advanced filters" Style="{StaticResource BodyLabel}"/>
                    <Label Text="• Indoor Floor Plans and building navigation" Style="{StaticResource BodyLabel}"/>
                    <Label Text="• QR Code Scanning for quick access" Style="{StaticResource BodyLabel}"/>
                    <Label Text="• Favorites and bookmarks" Style="{StaticResource BodyLabel}"/>
                    <Label Text="• Campus Events calendar" Style="{StaticResource BodyLabel}"/>
                    <Label Text="• Real-time notifications" Style="{StaticResource BodyLabel}"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1F22}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3A3D42}"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Technology Stack"
                           Style="{StaticResource SectionTitleLabel}"
                           SemanticProperties.HeadingLevel="Level2"/>
                    <Label Text="Framework: .NET 10 MAUI" Style="{StaticResource CaptionLabel}"/>
                    <Label Text="Platform: Android, iOS, Windows" Style="{StaticResource CaptionLabel}"/>
                    <Label Text="Database: Firebase Firestore" Style="{StaticResource CaptionLabel}"/>
                    <Label Text="Maps: MAUI.Controls.Maps" Style="{StaticResource CaptionLabel}"/>
                    <Label Text="QR: ZXing.Net.MAUI + MLKit" Style="{StaticResource CaptionLabel}"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="Resources"
                       Style="{StaticResource SectionTitleLabel}"
                       SemanticProperties.HeadingLevel="Level2"/>
                <Button Text="GitHub Repository"
                        Style="{StaticResource SecondaryButton}"
                        SemanticProperties.Description="Open the CampusGuide GitHub repository"
                        Clicked="OnGitHubClicked"/>
                <Button Text="Send Feedback"
                        Style="{StaticResource SecondaryButton}"
                        SemanticProperties.Description="Send feedback about CampusGuide by email"
                        Clicked="OnFeedbackClicked"/>
                <Button Text="View License"
                        Style="{StaticResource SecondaryButton}"
                        SemanticProperties.Description="View the MIT license for CampusGuide"
                        Clicked="OnLicenseClicked"/>
            </VerticalStackLayout>

            <Label Text="© 2026 CampusGuide. All rights reserved. Licensed under MIT License."
                   Style="{StaticResource CaptionLabel}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>
            <Label Text="Last Updated: November 2026"
                   Style="{StaticResource CaptionLabel}"
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
